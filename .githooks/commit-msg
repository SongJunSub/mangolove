#!/usr/bin/env bash
# ─────────────────────────────────────────────
# MangoLove: commit-msg 훅. 커밋 메시지의 금지 문장부호를 잡는다.
#
# tests/style.bats 는 추적 파일만 볼 수 있다. 커밋 메시지는 파일이 아니라
# 구조적으로 못 잡는다. 실제로 이 저장소의 커밋 13b2d0a 제목에 em dash 가
# 들어갔고, 푸시된 뒤라 되돌리지 못했다. 그 자리를 이 훅이 맡는다.
#
# 활성화(레포당 1회):
#   git config core.hooksPath .githooks
#
# 우회(감사됨): git commit --no-verify
# ─────────────────────────────────────────────
set -uo pipefail

MSG_FILE="${1:-}"
[ -n "$MSG_FILE" ] && [ -f "$MSG_FILE" ] || exit 0

# 금지 문자를 이 파일에 리터럴로 적지 않는다. 적으면 이 훅 자신이
# tests/style.bats 의 검사에 걸린다. UTF-8 바이트로 만든다.
EM_DASH="$(printf '\xe2\x80\x94')"   # U+2014
MIDDOT="$(printf '\xc2\xb7')"        # U+00B7

# 검사 대상 줄만 골라 "원본 줄번호:내용" 으로 만든다.
#  - 주석 줄(#)은 커밋에 포함되지 않는다. git 안내문의 금지 문자는 사용자 잘못이 아니다.
#  - scissors 아래는 `git commit -v` 가 붙인 diff 다. 커밋 메시지가 아닌데 거기 있는
#    em dash 로 커밋이 막혔다. 코드에서 em dash 를 지우는 커밋이 정확히 그 경우다.
#  - 줄번호는 **원본 파일 기준**으로 남긴다. 걸러낸 뒤 번호를 매기면 주석 수만큼 밀려
#    편집기에서 엉뚱한 줄을 가리킨다.
NUMBERED="$(awk '/^# -+ >8 -+$/ { exit } !/^#/ { printf "%d:%s\n", NR, $0 }' "$MSG_FILE")"

# NUMBERED 는 "줄번호:내용" 이라 줄머리 앵커(^)가 번호에 걸린다. 앵커는 ^[0-9]+: 로 쓴다.
_hits_fixed() { printf '%s\n' "$NUMBERED" | grep -F -- "$1" || true; }
_hits_re()    { printf '%s\n' "$NUMBERED" | grep -Ei -- "$1" || true; }

fail=0
# $1=제목, $2=적중한 줄들, $3=고치는 방법(선택)
_report() {
    echo "MangoLove commit-msg: $1" >&2
    printf '%s\n' "$2" | sed 's/^/  /' >&2
    [ -n "${3:-}" ] && echo "  $3" >&2
    fail=1
    return 0
}

hits="$(_hits_fixed "$EM_DASH")"
[ -n "$hits" ] && _report "커밋 메시지에 em dash 가 있습니다." "$hits" \
    "라벨과 설명 사이는 ':', 산문 삽입구는 '.' 또는 ',' 로 바꾸세요."

hits="$(_hits_fixed "$MIDDOT")"
[ -n "$hits" ] && _report "커밋 메시지에 가운뎃점이 있습니다." "$hits" \
    "나열은 ',', 한 덩어리 개념은 '과'/'와', 택일은 '/' 로 바꾸세요."

# AI 저작 표기 금지. 사용자 지침이며 하네스 기본 지침보다 우선한다.
# 사람 공저자(Co-Authored-By: 홍길동)는 정상이므로, AI 이름이 붙은 것만 잡는다.
hits="$(_hits_re '^[0-9]+:Co-Authored-By:.*(claude|copilot|gpt|gemini|cursor|codeium|devin)')"
[ -n "$hits" ] && _report "AI 를 공저자로 넣지 않습니다." "$hits"

hits="$(_hits_re '^[0-9]+:(Claude-Session|Generated-by|AI-Generated):|Generated with .*Claude Code|noreply@anthropic\.com')"
[ -n "$hits" ] && _report "AI 생성 표기를 남기지 않습니다." "$hits"

if [ "$fail" -ne 0 ]; then
    echo "" >&2
    echo "  부득이하면 --no-verify (감사 대상)." >&2
    exit 1
fi
exit 0
