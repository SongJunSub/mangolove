#!/usr/bin/env bash
# ─────────────────────────────────────────────
# MangoLove: pre-push 훅. 리뷰 게이트를 터미널 push 에도 적용한다.
#
# 왜 필요한가: 리뷰 게이트의 본체는 Claude Code 의 PreToolUse 훅이라 에이전트가 부른
# Bash 만 본다. 사용자가 터미널에서 직접 push 하면 게이트가 아예 뜨지 않는다. 그 구멍을
# 닫는다. 판정 로직은 복제하지 않고 review-gate.sh prepush 에 위임한다(단일 출처).
#
# 활성화(레포당 1회):
#   git config core.hooksPath .githooks
#
# 우회(감사됨): git push --no-verify
#               또는 touch .mangolove/.review-skip (1회용)
# 비활성: MANGOLOVE_REVIEW_GATE=off
# ─────────────────────────────────────────────
set -uo pipefail

case "${MANGOLOVE_REVIEW_GATE:-on}" in
    off|0|false|no) exit 0 ;;
esac

GATE="${MANGOLOVE_DIR:-$HOME/.mangolove}/lib/review-gate.sh"
# 게이트가 설치돼 있지 않은 머신에서 push 를 막지 않는다(fail-open).
[ -f "$GATE" ] || exit 0

# 버전 스큐 fail-open: 이 훅은 레포에 커밋돼 함께 배포되지만 게이트는 머신마다 따로
# 설치된다. 설치본이 prepush 를 모르는 구버전이면 usage 를 내고 exit 2 하므로, 그대로
# exec 하면 **그 머신의 push 가 전부 막힌다**(레포를 clone 한 동료, 아직 sync 하지 않은
# 자기 머신 포함). 훅이 게이트보다 앞서 나갈 수 있다는 것을 훅이 알고 있어야 한다.
# set -o pipefail 아래서는 파이프라인 종료코드가 **게이트의 usage exit 2** 가 되어,
# grep 이 맞았는지와 무관하게 `|| exit 0` 이 항상 발화한다. 즉 이 훅이 통째로 no-op 이었다.
# 변수에 받아 문자열로 판정한다.
_probe="$(bash "$GATE" 2>&1)"
case "$_probe" in *prepush*) ;; *) exit 0 ;; esac

# pre-push 는 stdin 으로 "<local ref> <local sha> <remote ref> <remote sha>" 를 준다.
# **버리지 않고 그대로 넘긴다**: 무엇이 실제로 올라가는지에 대한 유일한 권위 있는 정보다.
# 현재 브랜치를 가정하면 `git push origin other:main`, `--tags`, 삭제, detached HEAD 에서
# 엉뚱한 범위를 본다. 인자($1=원격 이름, $2=원격 URL)도 함께 넘겨 "git 이 불렀음"을 알린다.
exec bash "$GATE" prepush "$@"
