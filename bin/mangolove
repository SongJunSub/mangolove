#!/bin/bash
# ─────────────────────────────────────────────
# MangoLove: Autonomous Development Agent
# Powered by Claude Code
# https://github.com/SongJunSub/mangolove
# ─────────────────────────────────────────────

set -eo pipefail

MANGOLOVE_VERSION="0.7.0"
MANGOLOVE_DIR="${MANGOLOVE_DIR:-$HOME/.mangolove}"
SYSTEM_PROMPT_FILE="$MANGOLOVE_DIR/prompts/system-prompt.md"
WORK_LOGGER="$MANGOLOVE_DIR/lib/work-logger.sh"
PROFILE_MANAGER="$MANGOLOVE_DIR/lib/profile-manager.sh"
PLUGIN_MANAGER="$MANGOLOVE_DIR/lib/plugin-manager.sh"
SKILL_MANAGER="$MANGOLOVE_DIR/lib/skill-manager.sh"
SESSION_MEMORY="$MANGOLOVE_DIR/lib/session-memory.sh"
STATS_SCRIPT="$MANGOLOVE_DIR/lib/stats.sh"
COST_TRACKER="$MANGOLOVE_DIR/lib/cost-tracker.sh"
IMPACT_SCRIPT="$MANGOLOVE_DIR/lib/impact-score.sh"
EFFICACY_SCRIPT="$MANGOLOVE_DIR/lib/efficacy-recorder.sh"
REVIEW_SCRIPT="$MANGOLOVE_DIR/lib/review-gate.sh"
AUDIT_SCRIPT="$MANGOLOVE_DIR/lib/audit-methodology.sh"
EVAL_SCRIPT="$MANGOLOVE_DIR/lib/eval-harness.sh"
AB_SCRIPT="$MANGOLOVE_DIR/lib/ab-harness.sh"
BANNER_SCRIPT="$MANGOLOVE_DIR/lib/banner.sh"
# Methodology delivery (Branch by Abstraction): see MANGOLOVE_METHODOLOGY_MODE below.
CC_PLUGIN_DIR="$MANGOLOVE_DIR/cc-plugin"
CORE_METHODOLOGY_FILE="$MANGOLOVE_DIR/methodology/core.md"
STRICT_METHODOLOGY_FILE="$MANGOLOVE_DIR/methodology/strict.md"

# ─────────────────────────────────────────────
# Load user configuration
# ─────────────────────────────────────────────
MANGOLOVE_AUTO_LOG=true
MANGOLOVE_SHOW_BANNER=true
MANGOLOVE_EXTRA_PROMPT=""
MANGOLOVE_MODEL=""
MANGOLOVE_EFFORT=""
MANGOLOVE_MODE=""
MANGOLOVE_SESSION_GATES=true
# Methodology delivery: split (lean core.md + on-demand cc-plugin skills) | monolith (full strict.md).
# Default split: context 는 가장 비싼 자원이고, 상시 주입이 길수록 개별 지시의 효력이 희석된다.
# 트랙 판정, 승인 게이트, 안전 절차는 코어에 상주하고 무거운 절차만 온디맨드로 내려간다.
# core.md / cc-plugin 이 없으면 monolith 로 큰소리 폴백하므로 반쪽 설치가 방법론을 벗기지 않는다.
MANGOLOVE_METHODOLOGY_MODE="split"
# DoD gate (on / off): Stop 훅으로 완료 직전 ./.mangolove/dod.sh 를 결정적으로 검증.
# 기본 on. dod.sh 가 외부화되지 않았으면 즉시 통과하므로 idle 오버헤드가 없다.
# 세션 게이트 번들에 함께 주입되므로 MANGOLOVE_SESSION_GATES=true 필요.
MANGOLOVE_DOD_GATE=on
# Status line (on / off): context 사용률, 비용, 메서드러지 모드를 상태줄에 노출. 기본 on.
# mangolove 세션 동안 사용자 자체 statusLine 을 override 하므로 보존하려면 off.
MANGOLOVE_STATUSLINE=on
# Review gate (on / off): 커밋 경계에서 staged 변경의 track_floor 를 코드로 계산해
# 트랙별 필수 리뷰(/simplify, /code-review, /security-review) 실행 여부를 대조하고 미실행이면
# 커밋을 차단. Trivial/Small 은 아무 것도 요구하지 않아 사소한 작업엔 무비용. 기본 on.
MANGOLOVE_REVIEW_GATE=on
# 재개 안내 (on / off): 캐시가 만료된 큰 대화를 재개하면 재캐시 예상 비용을 한 줄로 보여준다.
# 사용자에게만 보이고 모델에는 닿지 않는다. 질문도 권유도 아니다.
MANGOLOVE_RESUME_NOTICE="${MANGOLOVE_RESUME_NOTICE:-on}"

if [ -f "$MANGOLOVE_DIR/config.sh" ]; then
    if bash -n "$MANGOLOVE_DIR/config.sh" 2>/dev/null; then
        # shellcheck source=/dev/null
        source "$MANGOLOVE_DIR/config.sh"
    else
        echo -e "\033[38;5;220mWarning: config.sh has syntax errors. Using defaults.\033[0m" >&2
        echo "  Run: bash -n ~/.mangolove/config.sh  to see errors." >&2
    fi
fi

# ─────────────────────────────────────────────
# Preflight check
# ─────────────────────────────────────────────
# 끄기로 해석하는 값들: config.sh 에 true/false 스타일이 섞여 있어 off 만 인정하면
# MANGOLOVE_REVIEW_GATE=false 라고 적은 사용자가 꺼졌다고 믿는데 켜져 있게 된다.
_ml_is_off() {
    case "$(printf '%s' "${1:-}" | tr '[:upper:]' '[:lower:]')" in
        off|false|0|no|disabled) return 0 ;;
        *) return 1 ;;
    esac
}

# 디렉토리의 프로젝트 지침 파일 경로를 낸다. 없으면 빈 출력.
# claude v2.1.277 부터 CLAUDE.md 가 없는 프로젝트는 AGENTS.md 를 읽는다. 같은 순서를 따른다.
_ml_instructions_file() {
    local d="${1:-.}"
    if [ -f "$d/CLAUDE.md" ]; then echo "$d/CLAUDE.md"
    elif [ -f "$d/AGENTS.md" ]; then echo "$d/AGENTS.md"
    fi
}

# MangoLove 가 claude 버전에 기대는 지점들. 사용자 설정이 아니라 사실이다.
#   권장 하한: v2.1.259 는 Stop 훅이 턴을 막은 직후 그 턴의 추론이 유실되고 일부 모델에서
#             프롬프트 캐시를 놓치던 문제를 고쳤다(DoD 게이트가 쓰는 경로). doctor 가 경고한다.
#   스냅샷 플래그: --system-prompt-snapshot 은 v2.1.257 에 생겼다(_ml_snapshot_args 참조).
#   재개 필드: SessionStart 훅의 재개 비용 필드는 v2.1.251 부터 온다(lib/resume-notice.sh).
ML_CLAUDE_RECOMMENDED="2.1.259"
ML_SNAPSHOT_FLAG_MIN="2.1.257"
ML_RESUME_FIELDS_MIN="2.1.251"

# "2.1.293 (Claude Code)" 같은 문자열에서 버전만 뽑는다. 없으면 빈 출력.
# 못 찾아도 0 으로 끝난다: 이 스크립트는 set -eo pipefail 이라, grep 의 "불일치(1)"가 그대로
# 나가면 `v=$(_ml_parse_version ...)` 한 줄이 호출자를 죽인다(버전 없는 래퍼, 개발 빌드).
_ml_parse_version() {
    printf '%s\n' "${1:-}" | grep -oE '[0-9]+\.[0-9]+\.[0-9]+' | head -1 || true
}

# 설치된 claude 의 버전. 못 읽으면 빈 문자열.
_ml_claude_version() {
    _ml_parse_version "$(claude --version 2>/dev/null)"
}

# $1 >= $2 인가. 점으로 나눈 세 자리를 수로 비교한다(문자열 비교는 2.1.99 를 2.1.257 보다 크게 본다).
# 어느 쪽이든 비어 있으면 거짓이다: 버전을 모르면 충족으로 치지 않는다.
_ml_version_ge() {
    [ -n "${1:-}" ] && [ -n "${2:-}" ] || return 1
    [ "$(printf '%s\n%s\n' "$1" "$2" | sort -t. -k1,1n -k2,2n -k3,3n | head -1)" = "$2" ]
}

# 재개 실행이면 시스템 프롬프트 스냅샷을 끄는 인자를 ML_SNAPSHOT_ARGS 에 담는다.
#
# claude v2.1.265 부터 대화 첫 요청의 시스템 프롬프트가 세션에 기록되고, --continue /
# --resume 뒤에도 압축 전까지 그 기록이 쓰인다. 재개하며 넘긴 새 --append-system-prompt 는
# 무시된다(v2.1.293 실측). 그대로 두면 --mode 전환, 프로필, 갱신된 방법론, 날짜가 든 작업
# 로그 경로가 전부 옛 값인데 훅은 새 코드라 게이트와 지시가 어긋난다.
#
# 새 대화에는 넘기지 않는다. 스냅샷은 프롬프트 캐시를 안정시키려고 생긴 것이고, 새 대화의
# 기록은 어차피 지금 넘기는 프롬프트다.
# 플래그가 없는 낮은 CLI(ML_SNAPSHOT_FLAG_MIN 미만)는 모르는 옵션으로 실행을 거부하므로
# 넘기지 않는다(그 버전대는 프롬프트 플래그를 주면 기록이 꺼졌으므로 필요도 없다).
# 결과는 전역 배열로 돌려준다: 명령치환은 빈 결과와 요소 경계를 잃는다.
ML_SNAPSHOT_ARGS=()
_ml_snapshot_args() {
    ML_SNAPSHOT_ARGS=()
    local a resume=0
    for a in "$@"; do
        case "$a" in
            --system-prompt-snapshot|--system-prompt-snapshot=*) return 0 ;;
            -c|--continue|-r|--resume|--resume=*|--from-pr|--from-pr=*) resume=1 ;;
        esac
    done
    [ "$resume" = "1" ] || return 0
    local version
    version="$(_ml_claude_version)"
    if [ -z "$version" ]; then
        # 모르는 버전에 플래그를 넘기면 낮은 CLI 는 실행을 거부한다. 넘기지 않되 조용히 넘어가지는
        # 않는다: 최신 CLI 였다면 재개한 대화가 옛 프롬프트로 도는 것을 사용자가 알 길이 없다.
        echo "△ claude 버전을 읽지 못해 --system-prompt-snapshot off 를 넘기지 않았습니다. 재개한 대화가 처음 기록된 시스템 프롬프트로 돌 수 있습니다." >&2
        return 0
    fi
    _ml_version_ge "$version" "$ML_SNAPSHOT_FLAG_MIN" || return 0
    ML_SNAPSHOT_ARGS=(--system-prompt-snapshot off)
}

# `mangolove resume` 이 시스템 프롬프트에 덧붙일 MangoLove 세션 메모리. 없으면 빈 출력.
#
# 첫 사용자 메시지로 넘기지 않는다. 그러면 재개 즉시 요청이 나가고, 캐시가 만료된 큰 대화에서는
# 사용자가 판단하기도 전에 컨텍스트 전체를 다시 캐시에 쓰는 비용이 발생한다. 시스템 프롬프트에
# 두면 사용자가 무언가 입력할 때까지 아무 요청도 나가지 않는다. 재개한 대화가 기록된 프롬프트를
# 쓰는 문제는 _ml_launch 가 스냅샷을 꺼서 푼다.
_ml_resume_context() {
    local session_context=""
    session_context=$(bash "$SESSION_MEMORY" load 2>/dev/null) || true
    [ -n "$session_context" ] || return 0
    printf '%s\n' "## Previous Session Context
${session_context}

Continue from where you left off. Summarize the previous session state and ask what to work on next."
}

# 마지막 단계: CLAUDE_ARGS 를 실어 claude 를 띄운다.
#
# `mangolove resume`(ML_RESUME=1)은 직전 대화를 -c 로 잇는다. 이을 대화가 없으면 -c 가
# 실패하므로 새 대화를 연다(종료코드로 판단하는 것은 예전부터의 동작이다).
_ml_launch() {
    if [ "${ML_RESUME:-0}" = "1" ]; then
        _ml_snapshot_args -c "$@"
        claude "${CLAUDE_ARGS[@]}" "${ML_SNAPSHOT_ARGS[@]}" -c "$@" 2>/dev/null \
            || claude "${CLAUDE_ARGS[@]}" "$@"
        return
    fi
    _ml_snapshot_args "$@"
    claude "${CLAUDE_ARGS[@]}" "${ML_SNAPSHOT_ARGS[@]}" "$@"
}

check_dependencies() {
    if ! command -v claude &> /dev/null; then
        echo ""
        echo -e "\033[38;5;203m✗ Claude Code is not installed.\033[0m"
        echo ""
        echo "  MangoLove requires Claude Code to run."
        echo "  Install it from: https://claude.ai/claude-code"
        echo ""
        exit 1
    fi
}

# ─────────────────────────────────────────────
# Build the full system prompt
# ─────────────────────────────────────────────
build_system_prompt() {
    local base_prompt=""
    if [ -f "$SYSTEM_PROMPT_FILE" ]; then
        base_prompt=$(cat "$SYSTEM_PROMPT_FILE")
    else
        base_prompt="You are MangoLove, an autonomous development agent. Analyze, plan, execute, and verify tasks autonomously."
    fi

    # Load project profile
    local project_context=""
    project_context=$(bash "$PROFILE_MANAGER" load 2>/dev/null) || true

    # Build work log instruction
    local log_instruction=""
    if [ "$MANGOLOVE_AUTO_LOG" = "true" ]; then
        log_instruction="

## Work Logging
After completing significant tasks, update the daily work log at:
\`~/.mangolove/logs/repo/logs/$(date '+%Y/%m')/$(date '+%Y-%m-%d').md\`
with a brief summary of what was accomplished."
    fi

    # Load mode-specific prompt
    local mode_prompt=""
    if [ -n "$MANGOLOVE_MODE" ]; then
        local mode_file="$MANGOLOVE_DIR/prompts/modes/${MANGOLOVE_MODE}.md"
        if [ -f "$mode_file" ]; then
            mode_prompt=$(cat "$mode_file")
        fi
    fi

    # Combine
    local full_prompt="${base_prompt}"

    if [ -n "$mode_prompt" ]; then
        full_prompt="${full_prompt}

---

${mode_prompt}"
    fi

    if [ -n "$project_context" ]; then
        full_prompt="${full_prompt}

---

## Active Project Profile
${project_context}"
    else
        full_prompt="${full_prompt}

---

## No Project Profile Found
The current directory does not match any known project profile.
On your first response, briefly analyze the project structure and offer to create a profile at:
\`~/.mangolove/projects/{name}.md\`"
    fi

    full_prompt="${full_prompt}${log_instruction}"

    # Load skill prompt additions
    local skill_additions=""
    skill_additions=$(bash "$SKILL_MANAGER" prompts 2>/dev/null) || true
    if [ -n "$skill_additions" ]; then
        full_prompt="${full_prompt}

---

## Skill Instructions
${skill_additions}"
    fi

    # Load plugin prompt additions
    local plugin_additions=""
    plugin_additions=$(bash "$PLUGIN_MANAGER" prompts 2>/dev/null) || true
    if [ -n "$plugin_additions" ]; then
        full_prompt="${full_prompt}

---

## Plugin Instructions
${plugin_additions}"
    fi

    if [ -n "$MANGOLOVE_EXTRA_PROMPT" ]; then
        full_prompt="${full_prompt}

---

## User Custom Instructions
${MANGOLOVE_EXTRA_PROMPT}"
    fi

    echo "$full_prompt"
}

# ─────────────────────────────────────────────
# Subcommands
# ─────────────────────────────────────────────
show_version() {
    echo "MangoLove v${MANGOLOVE_VERSION}"
}

show_help() {
    echo ""
    echo -e "\033[38;5;208m\033[1mMangoLove\033[0m v${MANGOLOVE_VERSION} - Autonomous Development Agent"
    echo ""
    echo "Usage:"
    echo "  mangolove                     Start interactive session"
    echo "  mangolove [prompt]            Start with a specific task"
    echo "  mangolove -p [prompt]         Print mode (non-interactive)"
    echo ""
    echo "Commands:"
    echo "  mangolove resume              Show last session context and continue"
    echo "  mangolove sessions            List all saved sessions"
    echo "  mangolove stats [period]      Productivity stats (today/week/month)"
    echo "  mangolove cost [period]       Token usage and cost (today/week/month/all)"
    echo "  mangolove cost sessions       Per-session cost concentration (which sessions burned it)"
    echo "  mangolove impact [sha]        Deterministic track/impact of a change (working tree or commit)"
    echo "  mangolove efficacy            Methodology efficacy: what the gates caught, and what they let through"
    echo "  mangolove review              Review gate status for the current push range (what would block)"
    echo "  mangolove audit-methodology   Audit the methodology file: volume, dead rules, delete candidates"
    echo "  mangolove eval                Self-eval: deterministic component scores (impact calibration, guard P/R)"
    echo "  mangolove ab                  A/B harness (Phase 4 v2): methodology vs bare claude (gate protection + scorer)"
    echo "  mangolove ab live             Run cc-plugin evals with and without the plugin (real sessions, billed)"
    echo "  mangolove switch <project>    Start a MangoLove session in that project directory"
    echo "  mangolove projects            List project profiles"
    echo "  mangolove profile add         Add a new project profile"
    echo "  mangolove profile auto [dir]  Auto-generate profile from project scan"
    echo "  mangolove profile export <n>  Export profile as .mangolove.md for team"
    echo "  mangolove profile import [f]  Import .mangolove.md to personal profiles"
    echo "  mangolove profile remove <n>  Remove a project profile"
    echo "  mangolove skill               List installed skills"
    echo "  mangolove skill install <url> Install a skill pack from git URL"
    echo "  mangolove skill create <name> Create a new skill pack template"
    echo "  mangolove skill remove <name> Remove a skill pack"
    echo "  mangolove skill update [name] Update skill pack(s)"
    echo "  mangolove plugin              List installed plugins"
    echo "  mangolove plugin create <n>   Create a new plugin from template"
    echo "  mangolove plugin enable <n>   Enable a plugin"
    echo "  mangolove plugin disable <n>  Disable a plugin"
    echo "  mangolove log init            Initialize work log repository"
    echo "  mangolove log view            Open work logs in browser"
    echo "  mangolove log search <term>   Search work logs"
    echo "  mangolove log recent          Show recent sessions"
    echo "  mangolove update              Update MangoLove to latest version"
    echo "  mangolove doctor              Check installation health"
    echo "  mangolove help                Show this help"
    echo "  mangolove --version           Show version"
    echo ""
    echo "Modes:"
    echo "  mangolove --mode review       Code review mode"
    echo "  mangolove --mode debug        Debug & root-cause analysis mode"
    echo "  mangolove --mode refactor     Refactoring mode"
    echo "  mangolove --mode security     Security audit mode"
    echo "  mangolove --mode plan         Planning mode"
    echo "  mangolove --mode pr           PR creation mode"
    echo "  mangolove --mode tdd          Test-driven development mode"
    echo "  mangolove --mode strict       Strict mode (auto lint/test/build)"
    echo "  mangolove --mode docs         Documentation sync mode"
    echo ""
    echo "Options (passed through to Claude Code):"
    echo "  -c, --continue                Continue last conversation"
    echo "  -r, --resume                  Resume a session"
    echo "  --model [model]               Select model (fable / opus / sonnet / haiku, or full id)"
    echo "  --effort [level]              Effort level (low / medium / high / xhigh / max)"
    echo ""
    echo "Examples:"
    echo "  mangolove"
    echo "  mangolove \"예약 API 리팩토링해줘\""
    echo "  mangolove -c"
    echo "  mangolove --model opus --effort xhigh \"시스템 전체 분석해줘\""
    echo ""
    echo "Config: ~/.mangolove/config.sh"
    echo "Docs:   https://github.com/SongJunSub/mangolove"
    echo ""
}

# 옛 게이트가 설치본의 추적 파일 .gitignore 에 덧붙인 줄을 pull 전에 되돌린다. $1=설치본 경로
#
# 홈 디렉토리에서 세션을 돌리면 게이트는 ./.mangolove(= 설치본)를 프로젝트의 작업 폴더로 보고
# 그 .gitignore 에 무시 줄을 심었다. 게이트는 이제 그 자리에 쓰지 않지만(lib/dod-gate.sh 의
# _ml_seed_gitignore) 이미 남은 줄은 여기서 치운다. 남겨 두면 .gitignore 를 바꾸는 업데이트의
# pull 이 "로컬 수정을 덮어쓴다"며 거부된다.
# 게이트가 심던 줄을 걷어낸 결과가 HEAD 의 내용과 같을 때만 되돌린다. 사용자가 손댄 줄이 하나라도
# 섞여 있으면 건드리지 않는다.
_ml_heal_install_gitignore() {
    local dir="${1:-$MANGOLOVE_DIR}" stripped
    [ -e "$dir/.git" ] && [ -f "$dir/.gitignore" ] || return 0
    # 수정이 없거나 추적하지 않는 파일이면 diff 가 조용히 0 을 낸다
    git -C "$dir" diff --quiet -- .gitignore 2>/dev/null && return 0
    stripped="$(grep -vxE '\.gitignore|dod\.sh|\.dod-gate-attempts|\.review-ledger|\.review-ledger\.base|\.review-skip|\.review-covered' "$dir/.gitignore" || true)"
    [ "$stripped" = "$(git -C "$dir" show HEAD:.gitignore 2>/dev/null)" ] || return 0
    git -C "$dir" checkout -q -- .gitignore 2>/dev/null || true
}

# 설치본을 origin/main 으로 올린다. $@ 는 git pull 에 그대로 넘긴다(--quiet 등).
#   --ff-only  : 실패한 pull 이 트리를 건드리지 않는다. 병합 충돌이 스크립트에 충돌 표시를 남기면
#                게이트가 구문 오류로 죽은 채 세션이 뜬다.
#   --no-rebase: 전역 설정에 pull.rebase 가 켜져 있으면, 로컬 수정이 있는 설치본에서 git 이
#                fast-forward 판정 전에 거부한다.
# 로컬 수정을 치웠다 되돌리는 autostash 는 쓰지 않는다. 되돌리다 충돌하면 pull 은 성공으로
# 끝나는데 파일에는 충돌 표시가 남는다. 사용자가 직접 고친 파일을 새 버전이 건드리면 git 이
# 아무것도 바꾸지 않고 거부하게 두고, 호출한 쪽이 그 사실을 알린다.
_ml_pull_install() {
    _ml_heal_install_gitignore "$MANGOLOVE_DIR"
    git -C "$MANGOLOVE_DIR" pull --ff-only --no-rebase "$@" origin main
}

_sync_after_pull() {
    local new_version
    new_version=$(grep -m1 '^MANGOLOVE_VERSION=' "$MANGOLOVE_DIR/bin/mangolove" | cut -d'"' -f2)
    if [ -n "$new_version" ]; then
        echo "$new_version" > "$MANGOLOVE_DIR/.version"
    fi
    chmod +x "$MANGOLOVE_DIR/bin/mangolove"
    find "$MANGOLOVE_DIR/lib" -name "*.sh" -exec chmod +x {} +
    echo "$new_version"
}

do_update() {
    local current_version
    current_version=$(cat "$MANGOLOVE_DIR/.version" 2>/dev/null || echo "unknown")
    echo "🔄 Updating MangoLove... (current: v${current_version})"

    if [ ! -d "$MANGOLOVE_DIR/.git" ]; then
        echo "⚠️  MangoLove was not installed via git."
        echo "   Re-install: curl -fsSL https://raw.githubusercontent.com/SongJunSub/mangolove/main/install.sh | bash"
        return 0
    fi

    (
        cd "$MANGOLOVE_DIR" || exit 1
        local before_commit
        before_commit=$(git rev-parse HEAD)

        if ! _ml_pull_install; then
            echo ""
            echo "⚠️  업데이트하지 못했습니다. 설치본 상태: git -C \"$MANGOLOVE_DIR\" status"
            exit 1
        fi

        local after_commit
        after_commit=$(git rev-parse HEAD)

        local new_version
        new_version=$(_sync_after_pull)

        if [ "$before_commit" = "$after_commit" ]; then
            echo "✅ Already up to date. (v${new_version:-$current_version})"
        else
            echo ""
            echo "📋 Changes:"
            git log --oneline "${before_commit}..${after_commit}"
            echo ""
            echo "✅ Updated: v${current_version} → v${new_version:-$current_version}"
        fi
    )
}

auto_update_check() {
    [ ! -d "$MANGOLOVE_DIR/.git" ] && return 0

    local check_file="$MANGOLOVE_DIR/.last_update_check"
    local now
    now=$(date +%s)
    local last_check=0

    if [ -f "$check_file" ]; then
        last_check=$(<"$check_file")
    fi
    # 깨진 값이 아래 산술을 오류로 만들어 실행을 끝내지 않게 한다. 숫자가 아니면 0 으로 보고,
    # 10# 으로 10진수임을 못박는다: 0 으로 시작하는 값(08)은 8진수로 읽혀 역시 오류가 난다.
    case "$last_check" in ''|*[!0-9]*) last_check=0 ;; esac

    local elapsed=$((now - 10#$last_check))
    if [ "$elapsed" -lt 86400 ]; then
        return 0
    fi

    # 업데이트 확인은 실행을 막아서는 안 된다. 예전에는 pull 이 실패하면 이 서브셸이 죽고 그
    # 종료코드로 mangolove 자체가 끝났다(확인 시각도 남지 않아 실행할 때마다 반복).
    # `|| rc=$?` 로 받으면 서브셸 안에서는 errexit 가 꺼지므로 실패는 아래에서 직접 다룬다.
    local rc=0
    (
        cd "$MANGOLOVE_DIR" || exit 1

        git fetch origin main --quiet 2>/dev/null || exit 0

        local local_head remote_head
        local_head=$(git rev-parse HEAD)
        remote_head=$(git rev-parse origin/main 2>/dev/null)

        [ "$local_head" = "$remote_head" ] && exit 0

        local current_version
        current_version=$(cat "$MANGOLOVE_DIR/.version" 2>/dev/null || echo "unknown")

        echo ""
        echo -e "\033[38;5;208m⬆ MangoLove 업데이트가 있습니다 (현재: v${current_version})\033[0m"

        if ! _ml_pull_install --quiet 2>/dev/null; then
            echo -e "\033[38;5;220m△ 자동 업데이트에 실패했습니다. 설치된 버전으로 계속합니다. 원인은 'mangolove update' 로 확인할 수 있습니다.\033[0m"
            echo ""
            exit 3
        fi

        local new_version
        new_version=$(_sync_after_pull)

        echo -e "\033[38;5;113m✅ v${current_version} → v${new_version:-unknown} 업데이트 완료\033[0m"
        echo ""
    ) || rc=$?

    # 다음 확인은 하루 뒤다. pull 실패(3)만 한 시간 뒤로 당긴다: 일시적인 실패(다른 터미널과의
    # 잠금 충돌, 끊긴 네트워크)를 하루 묵히지 않되, 계속 실패하는 설치본이 실행할 때마다 네트워크
    # 확인과 경고를 되풀이하지도 않게 한다.
    [ "$rc" = "3" ] && now=$((now - 86400 + 3600))
    echo "$now" > "$check_file" 2>/dev/null || true
}

do_doctor() {
    echo ""
    echo -e "\033[38;5;208m\033[1mMangoLove Doctor\033[0m"
    echo -e "\033[2m──────────────────────────────────────\033[0m"

    # Check Claude Code
    local cver=""
    if command -v claude &> /dev/null; then
        local cv
        cv=$(claude --version 2>/dev/null)
        cver=$(_ml_parse_version "$cv")
        # 버전을 못 읽으면 경고하지 않는다(모르는 것을 낮다고 단정하지 않는다).
        if [ -n "$cver" ] && ! _ml_version_ge "$cver" "$ML_CLAUDE_RECOMMENDED"; then
            echo -e "  \033[38;5;220m△\033[0m Claude Code: ${cv} (${ML_CLAUDE_RECOMMENDED} 이상 권장: Stop 훅이 턴을 막은 뒤 추론이 유실되던 문제의 수정)"
        else
            echo -e "  \033[38;5;113m✓\033[0m Claude Code: ${cv}"
        fi
    else
        echo -e "  \033[38;5;203m✗\033[0m Claude Code: not found"
    fi

    # Check GitHub CLI
    if command -v gh &> /dev/null; then
        local gv
        gv=$(gh --version 2>/dev/null | head -1)
        echo -e "  \033[38;5;113m✓\033[0m GitHub CLI: ${gv}"

        if gh auth status &> /dev/null; then
            echo -e "  \033[38;5;113m✓\033[0m GitHub Auth: authenticated"
        else
            echo -e "  \033[38;5;203m✗\033[0m GitHub Auth: not authenticated"
        fi
    else
        echo -e "  \033[38;5;220m△\033[0m GitHub CLI: not found (optional, for work logging)"
    fi

    # Check Git
    if command -v git &> /dev/null; then
        echo -e "  \033[38;5;113m✓\033[0m Git: $(git --version)"
    else
        echo -e "  \033[38;5;203m✗\033[0m Git: not found"
    fi

    # Check MangoLove files
    echo ""
    echo -e "  \033[2mInstallation:\033[0m"
    [ -f "$SYSTEM_PROMPT_FILE" ] && echo -e "  \033[38;5;113m✓\033[0m System prompt" || echo -e "  \033[38;5;203m✗\033[0m System prompt missing"
    [ -f "$BANNER_SCRIPT" ] && echo -e "  \033[38;5;113m✓\033[0m Banner" || echo -e "  \033[38;5;203m✗\033[0m Banner missing"
    [ -f "$WORK_LOGGER" ] && echo -e "  \033[38;5;113m✓\033[0m Work logger" || echo -e "  \033[38;5;203m✗\033[0m Work logger missing"
    [ -f "$PROFILE_MANAGER" ] && echo -e "  \033[38;5;113m✓\033[0m Profile manager" || echo -e "  \033[38;5;203m✗\033[0m Profile manager missing"

    # Count profiles
    local profile_count=0
    for p in "$MANGOLOVE_DIR/projects"/*.md; do
        [ "$(basename "$p")" = "README.md" ] && continue
        [ -f "$p" ] && profile_count=$((profile_count + 1))
    done
    echo -e "  \033[38;5;113m✓\033[0m Project profiles: ${profile_count}"

    # Count plugins
    local plugin_count=0
    for pd in "$MANGOLOVE_DIR/plugins"/*/; do
        [ -f "${pd}plugin.sh" ] && plugin_count=$((plugin_count + 1))
    done
    echo -e "  \033[38;5;113m✓\033[0m Plugins: ${plugin_count}"

    # Count modes
    local mode_count=0
    for mf in "$MANGOLOVE_DIR/prompts/modes"/*.md; do
        [ -f "$mf" ] && mode_count=$((mode_count + 1))
    done
    echo -e "  \033[38;5;113m✓\033[0m Modes: ${mode_count}"

    # Count skills
    local skill_count=0
    for sd in "$MANGOLOVE_DIR/skills"/*/; do
        [ -f "${sd}skill.yaml" ] || [ -f "${sd}skill.md" ] && skill_count=$((skill_count + 1))
    done
    echo -e "  \033[38;5;113m✓\033[0m Skills: ${skill_count}"

    # Methodology delivery (monolith / split) + cc-plugin health
    echo -e "  \033[38;5;113m✓\033[0m Methodology mode: ${MANGOLOVE_METHODOLOGY_MODE:-split}"
    if [ -f "$CORE_METHODOLOGY_FILE" ] && [ -f "$CC_PLUGIN_DIR/.claude-plugin/plugin.json" ]; then
        # "건너뜀"과 "실패"는 다른 상태다. 한 줄로 뭉개면 깨진 플러그인이 claude 미설치처럼
        # 보이고, claude 는 깨진 --plugin-dir 를 조용히 미로드한다. 실패면 사유를 보여준다.
        local pv_out
        if ! command -v claude &> /dev/null; then
            echo -e "  \033[38;5;220m△\033[0m cc-plugin: present (claude 가 없어 검증 건너뜀)"
        elif pv_out=$(claude plugin validate "$CC_PLUGIN_DIR" 2>&1); then
            echo -e "  \033[38;5;113m✓\033[0m cc-plugin: valid (core.md + skills ready for split)"
        else
            echo -e "  \033[38;5;203m✗\033[0m cc-plugin: 검증 실패 (split 세션에서 스킬이 로드되지 않습니다)"
            # 출력이 비어도 doctor 는 계속 간다(pipefail 아래에서 grep 의 "없음"은 실패다).
            printf '%s\n' "$pv_out" | grep -v '^[[:space:]]*$' | head -5 | sed 's/^/      /' || true
        fi
    else
        echo -e "  \033[38;5;220m△\033[0m cc-plugin/core.md: absent (split falls back to monolith)"
    fi

    # Session gates: bare mangolove 실행 시 자동 적용되는 게이트
    if [ "$MANGOLOVE_SESSION_GATES" = "true" ] && [ -f "$MANGOLOVE_DIR/lib/quality-gate.sh" ] && [ -f "$MANGOLOVE_DIR/lib/irreversible-guard.sh" ]; then
        echo -e "  \033[38;5;113m✓\033[0m Session gates: 시크릿 스캔 + 비가역 가드 (mangolove 실행 시 자동)"
    else
        echo -e "  \033[38;5;220m△\033[0m Session gates: off (MANGOLOVE_SESSION_GATES)"
    fi

    # DoD gate (Stop hook): 완료 직전 ./.mangolove/dod.sh 결정적 검증
    if [ "${MANGOLOVE_DOD_GATE:-on}" = "on" ] && [ -f "$MANGOLOVE_DIR/lib/dod-gate.sh" ]; then
        echo -e "  \033[38;5;113m✓\033[0m DoD gate: on (Stop 훅: 완료 직전 DoD 검증)"
    else
        echo -e "  \033[38;5;220m△\033[0m DoD gate: off (MANGOLOVE_DOD_GATE)"
    fi

    # Review gate: push 경계에서 트랙별 필수 리뷰 실행 여부를 결정적으로 대조
    if ! _ml_is_off "${MANGOLOVE_REVIEW_GATE:-on}" && [ -f "$MANGOLOVE_DIR/lib/review-gate.sh" ]; then
        echo -e "  \033[38;5;113m✓\033[0m Review gate: on (Medium 이상 push 에 필수 리뷰 강제)"
    else
        echo -e "  \033[38;5;220m△\033[0m Review gate: off (MANGOLOVE_REVIEW_GATE)"
    fi

    # Resume notice
    if ! _ml_is_off "${MANGOLOVE_RESUME_NOTICE:-on}" && [ -f "$MANGOLOVE_DIR/lib/resume-notice.sh" ]; then
        # 재개 필드가 없는 낮은 버전에서는 훅은 돌지만 보여줄 값이 없다.
        if [ -n "$cver" ] && ! _ml_version_ge "$cver" "$ML_RESUME_FIELDS_MIN"; then
            echo -e "  \033[38;5;220m△\033[0m Resume notice: on 이지만 표시되지 않음 (claude ${ML_RESUME_FIELDS_MIN} 이상 필요)"
        else
            echo -e "  \033[38;5;113m✓\033[0m Resume notice: on (캐시 만료된 대화 재개 시 재캐시 비용 표시)"
        fi
    else
        echo -e "  \033[38;5;220m△\033[0m Resume notice: off (MANGOLOVE_RESUME_NOTICE)"
    fi

    # Status line
    if ! _ml_is_off "${MANGOLOVE_STATUSLINE:-on}" && [ -f "$MANGOLOVE_DIR/lib/statusline.sh" ]; then
        echo -e "  \033[38;5;113m✓\033[0m Status line: on (context 사용률, 비용, 모드)"
    else
        echo -e "  \033[38;5;220m△\033[0m Status line: off (MANGOLOVE_STATUSLINE)"
    fi

    # Project quality gate: 현재 디렉토리가 게이트 설치된 프로젝트면 무결성/추적을 감사한다.
    if [ -f "$(pwd)/.mangolove/hooks/quality-gate.sh" ]; then
        echo ""
        echo -e "  \033[2mProject gate (cwd):\033[0m"
        echo -e "  \033[38;5;113m✓\033[0m Quality gate installed (.mangolove/hooks/)"
        if [ -f "$(pwd)/.mangolove/hooks/irreversible-guard.sh" ]; then
            echo -e "  \033[38;5;113m✓\033[0m Irreversible-command guard installed"
        else
            echo -e "  \033[38;5;220m△\033[0m irreversible-guard.sh missing: PreToolUse 가드가 fail-open(미차단)됩니다."
        fi
        if git rev-parse --git-dir > /dev/null 2>&1; then
            if git ls-files --error-unmatch .mangolove/hooks/quality-gate.sh > /dev/null 2>&1; then
                echo -e "  \033[38;5;113m✓\033[0m Gate is version-controlled (변조/누락이 diff 로 감사됨)"
            else
                echo -e "  \033[38;5;220m△\033[0m Gate not committed: run 'git add .mangolove/' to track it (감사 가능하도록)"
            fi
            if git check-ignore -q .mangolove > /dev/null 2>&1 || git check-ignore -q .mangolove/hooks > /dev/null 2>&1; then
                echo -e "  \033[38;5;203m✗\033[0m .mangolove/ is gitignored: 게이트가 조용히 무력화됩니다. ignore 에서 제외하세요."
            fi
        fi
    fi

    echo ""
    echo -e "\033[2m──────────────────────────────────────\033[0m"
    echo ""
}

handle_log() {
    case "${1:-}" in
        init)
            bash "$WORK_LOGGER" init
            ;;
        view)
            local repo_full=""
            if [ -n "$MANGOLOVE_LOG_REPO" ] && [ "$MANGOLOVE_LOG_REPO" != "disabled" ]; then
                repo_full="$MANGOLOVE_LOG_REPO"
            else
                local gh_user
                gh_user=$(gh api user --jq '.login' 2>/dev/null)
                repo_full="${gh_user}/mangolove-work-logs"
            fi
            open "https://github.com/${repo_full}" 2>/dev/null || \
            echo "https://github.com/${repo_full}"
            ;;
        search)
            bash "$WORK_LOGGER" search "${2:-}"
            ;;
        recent)
            bash "$WORK_LOGGER" recent
            ;;
        *)
            echo "Usage: mangolove log [init|view|search|recent]"
            ;;
    esac
}

handle_skill() {
    case "${1:-}" in
        install) bash "$SKILL_MANAGER" install "$2" ;;
        remove)  bash "$SKILL_MANAGER" remove "$2" ;;
        update)  bash "$SKILL_MANAGER" update "${2:-}" ;;
        create)  bash "$SKILL_MANAGER" create "$2" ;;
        *)       bash "$SKILL_MANAGER" list ;;
    esac
}

handle_plugin() {
    case "${1:-}" in
        enable)  bash "$PLUGIN_MANAGER" enable "$2" ;;
        disable) bash "$PLUGIN_MANAGER" disable "$2" ;;
        create)  bash "$PLUGIN_MANAGER" create "$2" ;;
        *)       bash "$PLUGIN_MANAGER" list ;;
    esac
}

handle_switch() {
    local query="${1:-}"

    if [ -z "$query" ]; then
        echo ""
        echo -e "\033[38;5;208m\033[1mMangoLove Switch\033[0m"
        echo -e "\033[2m──────────────────────────────────────\033[0m"

        # List available projects
        local count=0
        for profile in "$MANGOLOVE_DIR/projects"/*.md; do
            [ "$(basename "$profile")" = "README.md" ] && continue
            [ ! -f "$profile" ] && continue
            local name path
            name=$(grep "^name:" "$profile" 2>/dev/null | sed 's/^name: *//') || true
            path=$(grep "^path:" "$profile" 2>/dev/null | sed 's/^path: *//') || true
            local status="\033[38;5;113m*\033[0m"
            [ ! -d "$path" ] && status="\033[38;5;203mx\033[0m"
            echo -e "  ${status} \033[1m${name}\033[0m"
            echo -e "    \033[2m${path}\033[0m"
            count=$((count + 1))
        done

        # Also check CLAUDE.md in recent directories
        if [ $count -eq 0 ]; then
            echo -e "  \033[2mNo projects registered.\033[0m"
            echo -e "  \033[2mRun 'mangolove profile add' to register a project.\033[0m"
        fi

        echo ""
        echo -e "  Usage: mangolove switch <project-name>"
        echo ""
        return 0
    fi

    # Search for matching project
    local target_path=""
    for profile in "$MANGOLOVE_DIR/projects"/*.md; do
        [ "$(basename "$profile")" = "README.md" ] && continue
        [ ! -f "$profile" ] && continue
        local name path
        name=$(grep "^name:" "$profile" 2>/dev/null | sed 's/^name: *//') || true
        path=$(grep "^path:" "$profile" 2>/dev/null | sed 's/^path: *//') || true

        # Match by name (case-insensitive partial match)
        if echo "$name" | grep -iq "$query" 2>/dev/null; then
            target_path="$path"
            break
        fi
        # Match by filename
        local fname
        fname=$(basename "$profile" .md)
        if echo "$fname" | grep -iq "$query" 2>/dev/null; then
            target_path="$path"
            break
        fi
    done

    if [ -z "$target_path" ]; then
        echo -e "  \033[38;5;203mProject not found:\033[0m $query"
        echo -e "  \033[2mRun 'mangolove switch' to see available projects.\033[0m"
        return 1
    fi

    if [ ! -d "$target_path" ]; then
        echo -e "  \033[38;5;203mProject directory not found:\033[0m $target_path"
        return 1
    fi

    # 폴더만 옮긴다. 실행은 main 의 공통 경로가 한다: 여기서 claude 를 따로 띄우면 방법론도,
    # 세션 게이트(--settings)도, 플러그인도 없는 맨 claude 가 뜬다.
    echo -e "  \033[38;5;113mSwitching to:\033[0m $target_path"
    cd "$target_path" || return 1
}

handle_profile() {
    case "${1:-}" in
        add)     bash "$PROFILE_MANAGER" add ;;
        remove)  bash "$PROFILE_MANAGER" remove "$2" ;;
        auto)    bash "$PROFILE_MANAGER" auto "${2:-}" ;;
        export)  bash "$PROFILE_MANAGER" export "$2" "${3:-}" ;;
        import)  bash "$PROFILE_MANAGER" import "${2:-}" ;;
        *)       bash "$PROFILE_MANAGER" list ;;
    esac
}

# split 모드 프리플라이트: core.md 와 cc-plugin 매니페스트가 모두 존재해야 split 로 진행한다.
# claude 는 깨진/없는 --plugin-dir 를 조용히 미로드(exit 0, 무경고)하므로, 여기서 먼저 확인해
# 반쪽 설치가 게이트를 소리 없이 벗겨내는 것을 막고 monolith 로 폴백시킨다.
methodology_split_ready() {
    [ -f "$CORE_METHODOLOGY_FILE" ] && [ -f "$CC_PLUGIN_DIR/.claude-plugin/plugin.json" ]
}

# Recognized project build markers. Kept in one place so sub-project detection and the
# "is the CWD itself a project?" guard use the SAME set (they used to diverge: the guard
# only checked 3 of these, so the picker could false-positive inside Kotlin/Go/Rust/Python
# projects whose subdirs happen to be projects too).
_ml_has_build_marker() {
    local d="$1"
    [ -f "${d}/build.gradle" ] || [ -f "${d}/build.gradle.kts" ] || [ -f "${d}/package.json" ] \
        || [ -f "${d}/pom.xml" ] || [ -f "${d}/go.mod" ] || [ -f "${d}/Cargo.toml" ] \
        || [ -f "${d}/pyproject.toml" ]
}

# Detect a multi-project root: a directory holding >=2 immediate sub-dirs that are each their
# own git project (a .git plus a recognized build marker). Prints the sub-project names, one
# per line, when the picker should be offered; prints nothing otherwise. Scans the caller's CWD.
#
# Never treats these as multi-project roots (avoids the false-positive selector):
#   - $HOME and the filesystem root: common holders of several UNRELATED checkouts, never a
#     real monorepo/workspace root.
#   - a directory that is itself a project (has any build marker): you're already inside one.
detect_multi_project_root() {
    _ml_has_build_marker "." && return 0
    [ "$PWD" = "$HOME" ] && return 0
    [ "$PWD" = "/" ] && return 0

    local sub_dir found=()
    for sub_dir in */; do
        [ ! -d "$sub_dir" ] && continue
        if [ -d "${sub_dir}.git" ] && _ml_has_build_marker "${sub_dir%/}"; then
            found+=("$(basename "$sub_dir")")
        fi
    done

    [ "${#found[@]}" -ge 2 ] || return 0
    printf '%s\n' "${found[@]}"
}

# ─────────────────────────────────────────────
# Main
# ─────────────────────────────────────────────
main() {
    export MANGOLOVE_DIR
    # `mangolove resume` 서브커맨드만 1 로 올린다(_ml_launch 참조). 설정값이 아니므로 여기서
    # 0 으로 시작한다: config.sh 나 환경변수가 재개를 켜지 못한다.
    ML_RESUME=0

    case "${1:-}" in
        help|--help|-h)
            show_help
            exit 0
            ;;
        --version|-v)
            show_version
            exit 0
            ;;
        resume)
            # 예전에는 여기서 claude 를 따로 띄워 세션 게이트(--settings)와 플러그인 없이
            # 실행됐다. 이제 아래 공통 경로를 그대로 타고, 차이는 _ml_launch 가 낸다.
            bash "$SESSION_MEMORY" show
            ML_RESUME=1
            shift
            ;;
        sessions)
            bash "$SESSION_MEMORY" list
            exit 0
            ;;
        stats)
            shift
            bash "$STATS_SCRIPT" "${1:-week}"
            exit 0
            ;;
        cost)
            shift
            # 인자를 그대로 넘긴다. 뷰/기간 분기는 cost-tracker.sh 의 엔트리포인트가 갖고 있고,
            # 여기서 한 번 더 분기하면 뷰가 늘 때마다 두 파일을 같이 고쳐야 한다.
            bash "$COST_TRACKER" "$@"
            exit 0
            ;;
        impact)
            shift
            bash "$IMPACT_SCRIPT" report "${1:---working}"
            exit 0
            ;;
        efficacy)
            shift
            bash "$EFFICACY_SCRIPT" report
            exit 0
            ;;
        review)
            shift
            # 게이트가 push 시점에 무엇을 볼지 지금 보여준다. 차단 메시지가 안내하는 진단 경로.
            # status 로 고정한다: record/pretooluse 는 stdin 으로 훅 페이로드를 기다리는
            # 내부 모드라, 사람이 터미널에서 부르면 그대로 멈춰 선다.
            case "${1:-status}" in
                status) shift 2>/dev/null || true; bash "$REVIEW_SCRIPT" status "$@" ;;
                skip)   shift; bash "$REVIEW_SCRIPT" skip "$@" ;;
                *) echo "usage: mangolove review [status [<A...B>] | skip \"<근거>\"]" >&2; exit 2 ;;
            esac
            exit 0
            ;;
        audit-methodology)
            shift
            bash "$AUDIT_SCRIPT" "${1:-report}"
            exit 0
            ;;
        eval)
            shift
            bash "$EVAL_SCRIPT" "${1:-report}"
            exit 0
            ;;
        ab)
            shift
            [ $# -eq 0 ] && set -- report
            # `ab live` 는 뒤 인자를 claude plugin eval 에 그대로 넘긴다(--runs, --model, --case ...)
            bash "$AB_SCRIPT" "$@"
            exit $?
            ;;
        switch)
            shift
            # 이름이 없으면 목록만 낸다. 예전에는 목록을 찍고 그대로 흘러가 지금 폴더에서
            # 세션이 떴다.
            if [ $# -eq 0 ]; then
                handle_switch
                exit 0
            fi
            # 프로젝트 폴더로 옮긴 뒤 아래 공통 경로를 그대로 탄다(실패하면 set -e 로 끝난다).
            # 이름은 여기서 소비한다: 남기면 claude 의 프롬프트 인자가 된다.
            handle_switch "$1"
            shift
            ;;
        projects)
            bash "$PROFILE_MANAGER" list
            exit 0
            ;;
        profile)
            shift
            handle_profile "$@"
            exit 0
            ;;
        skill|skills)
            shift
            handle_skill "$@"
            exit 0
            ;;
        plugin|plugins)
            shift
            handle_plugin "$@"
            exit 0
            ;;
        log)
            shift
            handle_log "$@"
            exit 0
            ;;
        update)
            do_update
            exit 0
            ;;
        doctor)
            do_doctor
            exit 0
            ;;
    esac

    # Parse --mode flag before passing to claude
    local remaining_args=()
    while [ $# -gt 0 ]; do
        case "$1" in
            --mode|-m)
                if [ -n "${2:-}" ]; then
                    MANGOLOVE_MODE="$2"
                    local mode_file="$MANGOLOVE_DIR/prompts/modes/${MANGOLOVE_MODE}.md"
                    if [ ! -f "$mode_file" ]; then
                        echo -e "\033[38;5;203m✗ Unknown mode: ${MANGOLOVE_MODE}\033[0m"
                        echo ""
                        echo "  Available modes:"
                        for mf in "$MANGOLOVE_DIR/prompts/modes"/*.md; do
                            [ -f "$mf" ] && echo "    - $(basename "$mf" .md)"
                        done
                        echo ""
                        exit 1
                    fi
                    shift 2
                else
                    echo "Usage: mangolove --mode <mode> [prompt]"
                    exit 1
                fi
                ;;
            *)
                remaining_args+=("$1")
                shift
                ;;
        esac
    done
    set -- "${remaining_args[@]}"

    # Preflight
    check_dependencies

    # Auto-update check (once per 24h, non-blocking)
    auto_update_check

    # Detect multi-project root and, if so, let the user pick a sub-project.
    # (bash 3.2 on macOS: no mapfile; read the newline-separated list into an array.)
    local sub_projects=() line
    while IFS= read -r line; do
        [ -n "$line" ] && sub_projects+=("$line")
    done < <(detect_multi_project_root)

    if [ "${#sub_projects[@]}" -ge 2 ]; then
        echo ""
        echo -e "\033[38;5;208m\033[1mMangoLove\033[0m: Multi-project directory detected"
        echo ""
        local idx=1
        for sp in "${sub_projects[@]}"; do
            local sp_status=""
            [ -n "$(_ml_instructions_file "$sp")" ] && sp_status=" \033[38;5;113m(initialized)\033[0m"
            echo -e "  ${idx}) \033[1m${sp}\033[0m${sp_status}"
            idx=$((idx + 1))
        done
        echo ""
        read -rp "  Select project (1-${#sub_projects[@]}): " choice

        if [ -n "$choice" ] && [ "$choice" -ge 1 ] 2>/dev/null && [ "$choice" -le "${#sub_projects[@]}" ] 2>/dev/null; then
            local selected="${sub_projects[$((choice - 1))]}"
            echo -e "  \033[38;5;113m→\033[0m ${selected}"
            cd "$selected" || exit 1
        else
            echo "  Cancelled."
            exit 0
        fi
    fi

    # Run plugin on_session_start hooks
    bash "$PLUGIN_MANAGER" hook on_session_start 2>/dev/null || true

    # Show banner
    if [ "$MANGOLOVE_SHOW_BANNER" = "true" ]; then
        bash "$BANNER_SCRIPT"
    fi

    # Log session start (background, non-blocking)
    if [ "$MANGOLOVE_AUTO_LOG" = "true" ]; then
        bash "$WORK_LOGGER" start &>/dev/null &
    fi

    # Build system prompt
    SYSTEM_PROMPT=$(build_system_prompt)

    # Inject methodology (Branch by Abstraction).
    #   monolith (default): append full strict.md: behavior parity with pre-diet releases.
    #   split: append lean core.md and load heavy procedures on-demand via cc-plugin skills.
    # split falls back to monolith (loud) when core.md / cc-plugin are missing, so a partial
    # install never silently ships bare claude with the methodology stripped.
    local USE_CC_PLUGIN=0
    local methodology=""
    if [ "$MANGOLOVE_METHODOLOGY_MODE" = "split" ] && methodology_split_ready; then
        methodology=$(cat "$CORE_METHODOLOGY_FILE")
        USE_CC_PLUGIN=1
    else
        if [ "$MANGOLOVE_METHODOLOGY_MODE" = "split" ]; then
            echo -e "\033[38;5;220m△ methodology=split 요청됐지만 core.md/cc-plugin 이 없어 monolith 로 폴백합니다.\033[0m" >&2
        fi
        [ -f "$STRICT_METHODOLOGY_FILE" ] && methodology=$(cat "$STRICT_METHODOLOGY_FILE")
    fi
    if [ -n "$methodology" ]; then
        SYSTEM_PROMPT="${SYSTEM_PROMPT}

---

${methodology}"
    fi

    # mangolove resume: 세션 메모리를 시스템 프롬프트 끝에 덧붙인다 (_ml_resume_context 참조)
    if [ "$ML_RESUME" = "1" ]; then
        local resume_context=""
        resume_context=$(_ml_resume_context)
        if [ -n "$resume_context" ]; then
            SYSTEM_PROMPT="${SYSTEM_PROMPT}

---

${resume_context}"
        fi
    fi

    # Trap exit to log session end and run plugin hooks
    # Use timeout to prevent hanging on network issues
    # shellcheck disable=SC2154
    trap '
        bash "$SESSION_MEMORY" save 2>/dev/null &
        bash "$PLUGIN_MANAGER" hook on_session_end 2>/dev/null &
        _ml_plugin_pid=$!
        _ml_logger_pid=""
        if [ "$MANGOLOVE_AUTO_LOG" = "true" ]; then
            bash "$WORK_LOGGER" end 2>/dev/null &
            _ml_logger_pid=$!
        fi
        _ml_wait=0
        while [ $_ml_wait -lt 10 ]; do
            # 띄우지 않은 로거를 기다리지 않는다: pid 자리에 0 을 두면 kill -0 0 이 항상 성공해
            # 작업 로그를 끈 사용자는 종료할 때마다 10초를 기다렸다.
            kill -0 $_ml_plugin_pid 2>/dev/null \
                || { [ -n "$_ml_logger_pid" ] && kill -0 $_ml_logger_pid 2>/dev/null; } || break
            sleep 1
            _ml_wait=$((_ml_wait + 1))
        done
    ' EXIT

    # Build Claude args
    CLAUDE_ARGS=()
    CLAUDE_ARGS+=(--append-system-prompt "$SYSTEM_PROMPT")

    # split 모드: 메서드러지 스킬/에이전트를 이 세션에만 로드한다 (--plugin-dir 는 세션 한정이라
    # bare claude 는 불변). USE_CC_PLUGIN 은 위 프리플라이트를 통과했을 때만 1.
    if [ "$USE_CC_PLUGIN" = "1" ]; then
        CLAUDE_ARGS+=(--plugin-dir "$CC_PLUGIN_DIR")
    fi
    if [ -n "$MANGOLOVE_MODE" ]; then
        CLAUDE_ARGS+=(--name "MangoLove [${MANGOLOVE_MODE}]")
    else
        CLAUDE_ARGS+=(--name "MangoLove")
    fi

    [ -n "$MANGOLOVE_MODEL" ] && CLAUDE_ARGS+=(--model "$MANGOLOVE_MODEL")
    [ -n "$MANGOLOVE_EFFORT" ] && CLAUDE_ARGS+=(--effort "$MANGOLOVE_EFFORT")

    # 세션 게이트: bare mangolove 에서도 시크릿 스캔 + 비가역 가드를 자동 적용 (init 불필요).
    # claude --settings 로 PreToolUse hook 을 병합 주입한다 (사용자/프로젝트 설정은 안 건드림).
    if [ "$MANGOLOVE_SESSION_GATES" = "true" ] && [ -f "${MANGOLOVE_DIR}/lib/quality-gate.sh" ]; then
        local session_settings="$MANGOLOVE_DIR/session-settings.json"
        generate_session_settings "$session_settings"
        CLAUDE_ARGS+=(--settings "$session_settings")
    fi

    # Launch Claude Code
    _ml_launch "$@"
}

# 세션 게이트 설정 파일을 생성한다: bare mangolove 에서도 시크릿 게이트 + 비가역 가드를
# claude --settings 로 주입(init/프로젝트 셋업 불필요). $1=출력 파일 경로.
generate_session_settings() {
    local out="$1"
    local guard="${MANGOLOVE_DIR}/lib/irreversible-guard.sh"
    local gate="${MANGOLOVE_DIR}/lib/quality-gate.sh"
    local dod="${MANGOLOVE_DIR}/lib/dod-gate.sh"
    local statusline="${MANGOLOVE_DIR}/lib/statusline.sh"
    local review="${MANGOLOVE_DIR}/lib/review-gate.sh"
    local resume_notice="${MANGOLOVE_DIR}/lib/resume-notice.sh"

    # 리뷰 게이트는 훅 두 개가 짝을 이룬다: PostToolUse(Skill) 로 "실제 실행된 스킬"을 원장에
    # 남기고, PreToolUse(Bash) 로 git push 시점에 코드가 계산한 트랙과 대조한다.
    # 자기보고가 아니라 도구 호출 사실이 근거다.
    local review_pre="" review_post=""
    if ! _ml_is_off "${MANGOLOVE_REVIEW_GATE:-on}" && [ -f "$review" ]; then
        review_pre=$(cat << REVPREEOF
,
          { "type": "command", "command": "bash \\"${review}\\" pretooluse" }
REVPREEOF
)
        review_post=$(cat << REVPOSTEOF
,
    "PostToolUse": [
      {
        "matcher": "Skill",
        "hooks": [
          { "type": "command", "command": "bash \\"${review}\\" record" }
        ]
      }
    ]
REVPOSTEOF
)
    fi

    # Stop 훅은 게이트마다 독립된 조건으로 들어간다. 하나의 조건 블록에 묶으면
    # 한 게이트의 온오프가 다른 게이트의 환경변수에 종속된다.
    # 첫 훅이 exit 2 를 내도 같은 배열의 나머지 훅은 실행된다(실측 확인함).
    # 항목을 배열에 담고 마지막에 한 번 join 한다: 게이트를 늘려도 "비어있으면 콤마 빼기"
    # 보일러플레이트가 따라 늘지 않는다.
    local stop_entries=()
    # DoD 게이트: dod.sh 미외부화 시 무비용 통과하므로 idle 오버헤드가 없다.
    if [ "${MANGOLOVE_DOD_GATE:-on}" = "on" ] && [ -f "$dod" ]; then
        stop_entries+=("          { \"type\": \"command\", \"command\": \"bash \\\"${dod}\\\"\" }")
    fi
    local stop_block="" stop_hooks="" e
    for e in ${stop_entries+"${stop_entries[@]}"}; do
        [ -n "$stop_hooks" ] && stop_hooks="${stop_hooks},
"
        stop_hooks="${stop_hooks}${e}"
    done
    if [ -n "$stop_hooks" ]; then
        stop_block=$(cat << STOPEOF
,
    "Stop": [
      {
        "hooks": [
${stop_hooks}
        ]
      }
    ]
STOPEOF
)
    fi

    # 재개 안내: 캐시가 만료된 큰 대화를 재개할 때 재캐시 예상 비용을 사용자에게만 한 줄로
    # 보여준다(모델에는 닿지 않는다. lib/resume-notice.sh 참조). 재개 필드는 resume, fork 에만 온다.
    local resume_block=""
    if ! _ml_is_off "${MANGOLOVE_RESUME_NOTICE:-on}" && [ -f "$resume_notice" ]; then
        resume_block=$(cat << RNEOF
,
    "SessionStart": [
      {
        "matcher": "resume|fork",
        "hooks": [
          { "type": "command", "command": "bash \\"${resume_notice}\\"" }
        ]
      }
    ]
RNEOF
)
    fi

    # 상태줄: context 사용률, 비용, 모드 노출. MANGOLOVE_STATUSLINE=off 로 비활성(사용자 statusLine 보존).
    local statusline_block=""
    if ! _ml_is_off "${MANGOLOVE_STATUSLINE:-on}" && [ -f "$statusline" ]; then
        local eff_mode="monolith"
        [ "${USE_CC_PLUGIN:-0}" = "1" ] && eff_mode="split"
        statusline_block=$(cat << SLEOF
  "statusLine": { "type": "command", "command": "MANGOLOVE_STATUSLINE_MODE=${eff_mode} MANGOLOVE_STATUSLINE_DOD=${MANGOLOVE_DOD_GATE:-on} bash \\"${statusline}\\"", "padding": 0 },
SLEOF
)
    fi

    # AI 저작 표기 금지(방법론)를 설정으로 닫는다: 커밋 트레일러와 PR 푸터를 비운다.
    # "attribution": false 단축형(v2.1.281+)은 쓰지 않는다. 구버전 CLI 는 그 값을 든 설정
    # 파일을 통째로 건너뛰고, 그러면 이 파일이 싣는 게이트 훅까지 함께 빠진다.
    cat > "$out" << SESSIONEOF
{
  "attribution": { "commit": "", "pr": "" },
  "permissions": {
    "allow": ["Bash(mangolove review skip:*)"]
  },
${statusline_block}
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          { "type": "command", "command": "bash \\"${guard}\\"" },
          { "type": "command", "command": "GATE_SECRET=block bash \\"${gate}\\" pretooluse" }${review_pre}
        ]
      }
    ]${review_post}${stop_block}${resume_block}
  }
}
SESSIONEOF
}

# 직접 실행 시에만 main 호출 (테스트에서 source 가능하도록 가드)
if [ "${BASH_SOURCE[0]}" = "${0}" ]; then
    main "$@"
fi
