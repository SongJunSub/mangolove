#!/bin/bash
# ─────────────────────────────────────────────
# 🥭 MangoLove: User Configuration
# ─────────────────────────────────────────────
# Copy this file to ~/.mangolove/config.sh and customize.
# Values here override defaults.
# ─────────────────────────────────────────────

# GitHub work log repository (default: auto-detected as {gh-username}/mangolove-work-logs)
# Set to "disabled" to turn off work logging entirely
MANGOLOVE_LOG_REPO=""

# Auto-log sessions to GitHub (true / false)
MANGOLOVE_AUTO_LOG=true

# Show banner on startup (true / false)
MANGOLOVE_SHOW_BANNER=true

# Extra text appended to system prompt (for personal preferences)
MANGOLOVE_EXTRA_PROMPT=""

# Default Claude model (leave empty to use Claude Code default)
#   Aliases: fable / opus / sonnet / haiku, or a full id such as claude-opus-5.
MANGOLOVE_MODEL=""

# Default effort level (low / medium / high / xhigh / max)
#   Leave empty to use the Claude Code default (xhigh), which is the recommended
#   level for coding and agentic work. Lower it for cheap, routine turns.
MANGOLOVE_EFFORT=""

# Methodology delivery (split / monolith)
#   split:    inject a lean core.md and load heavy Spec/review procedures on-demand as
#              cc-plugin skills (default). Always-on volume drops ~36%; track decision,
#              approval gates and safety procedures stay resident in the core.
#              Falls back to monolith (loudly) if core.md / cc-plugin are missing.
#   monolith: inject the full strict.md methodology every session.
MANGOLOVE_METHODOLOGY_MODE=split

# DoD gate (on / off): 완료 직전 ./.mangolove/dod.sh 를 Stop 훅으로 결정적 검증
#   모델이 완료를 주장하기 전에 DoD 를 실행형 체크로 외부화하면, 통과 전까지 턴이 끝나지 않는다.
#   기본 on. dod.sh 를 외부화하지 않은 턴은 즉시 통과하므로 idle 비용이 없다.
#   세션 게이트 번들에 함께 주입되므로 MANGOLOVE_SESSION_GATES=true 필요.
MANGOLOVE_DOD_GATE=on

# Status line (on / off): context 사용률, 세션 비용, 메서드러지 모드를 상태줄에 노출
#   기본 on. mangolove 세션 동안 사용자 자체 statusLine 을 override 하므로 보존하려면 off.
MANGOLOVE_STATUSLINE=on

# Review gate (on / off): 커밋 경계에서 트랙별 필수 리뷰를 결정적으로 강제
#   staged 변경의 track_floor 를 impact-score 로 계산해, Medium 이상인데 /simplify,
#   /code-review, (Large 또는 DB/인증/외부API 는) /security-review 가 이 세션에서 실행되지
#   않았으면 커밋을 차단한다. Trivial/Small 은 아무 것도 요구하지 않으므로 사소한
#   작업에는 무비용. 기본 on. 우회(감사됨): MANGOLOVE_SKIP_REVIEW=1
MANGOLOVE_REVIEW_GATE=on

# Session context budget (on / off): 컨텍스트가 커지면 끊을 지점을 결정적으로 알린다
#   실측에서 비용은 세션 크기에 극단적으로 쏠렸다(상위 10세션이 총비용의 64%, 턴 300+ 인
#   45세션이 95%, 상위 세션의 peak context 는 전부 1M 천장). 캐시 적중률은 이미 97.9% 라
#   캐시는 레버가 아니다. 그런데 대응은 상태줄의 시각 넛지 하나뿐이었다.
#   Stop 훅이 transcript 에서 현재 컨텍스트를 읽어 임계 도달 시 1회 안내한다(버킷당 1회).
#   차단이 아니라 안내지만, 모델에 메시지를 전달하는 경로가 exit 2 뿐이라 그 턴을 한 번 붙잡는다.
#   off 면 훅 자체가 주입되지 않는다(= 진짜 0 비용).
#   config.sh 는 bin/mangolove 의 기본값 **뒤에** source 되므로, 단순 대입으로 쓰면
#   `MANGOLOVE_SESSION_BUDGET=off mangolove` 같은 셸 환경변수를 덮어쓴다.
#   그래서 :- 형태로 둔다: 환경변수가 있으면 그것이, 없으면 이 값이 이긴다.
MANGOLOVE_SESSION_BUDGET="${MANGOLOVE_SESSION_BUDGET:-on}"

# 안내를 낼 컨텍스트 임계(토큰). 이후 배증할 때마다 다시 알린다(400K → 800K).
#   기본 400000 은 재보정값이다(135세션). 처음 쓰던 200K 는 "싼 세션을 안 건드린다"는
#   기준으로 골랐는데, 재측정에서 그 기준은 200K~800K 어디서도 똑같이 만족돼 판별력이 없었다.
#   실제로 갈리는 것은 안내가 행동으로 옮겨질 지점인가다: 200K 알림 뒤에도 세션은 컨텍스트를
#   중앙값 2.75배 더 늘렸다(= 갈 길이 한참 남아 무시하는 게 옳았다). 400K 는 1.66배로,
#   1M 윈도우의 40% 지점이고 다음 버킷 800K 가 80% 라 사다리가 창 크기와 맞는다.
#   비용커버는 94.3% → 82.9% 로 내려가지만, 그 차이는 무시되던 안내로는 지켜지지 않던 돈이다.
#   더 조용히 쓰려면 500000(알림 세션당 1회), 더 촘촘히 보려면 300000.
MANGOLOVE_SESSION_BUDGET_TOKENS="${MANGOLOVE_SESSION_BUDGET_TOKENS:-400000}"
